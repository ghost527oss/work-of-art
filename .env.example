# Optional. Server-side only (never use a VITE_ prefix: that would expose it to the browser).
# Use a fine-grained token limited to public repositories (read-only). Leave empty for anonymous access.
GITHUB_TOKEN=

# AI mode. Leave empty (or "mock") for canned example answers and no outside calls. Set "live" to use a free AI provider.
AI_MODE=

# Live AI keys (used only when AI_MODE=live). All are optional: a provider with no key is skipped.
# The order tried is Gemini, then Groq, then OpenRouter. With no key at all, live mode says "Live AI is not set up".
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides (empty = use the built-in default). "Light" is for explanations and safe actions, "heavy" for code changes.
# Free model names change often; set these if a default is retired.
# Defaults: gemini-3.1-flash-lite / gemini-3.6-flash, openai/gpt-oss-20b / openai/gpt-oss-120b, openrouter/free (both)
GEMINI_MODEL_LIGHT=
GEMINI_MODEL_HEAVY=
GROQ_MODEL_LIGHT=
GROQ_MODEL_HEAVY=
OPENROUTER_MODEL_LIGHT=
OPENROUTER_MODEL_HEAVY=
